{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "college-scorecard-mcp-server",
  "version": "0.1.8",
  "description": "Search, compare, and analyze U.S. college data — costs, earnings, programs, and outcomes — via MCP. STDIO or Streamable HTTP.",
  "author": {
    "name": "cyanheads",
    "email": "casey@caseyjhand.com",
    "url": "https://github.com/cyanheads"
  },
  "homepage": "https://github.com/cyanheads/college-scorecard-mcp-server",
  "repository": "https://github.com/cyanheads/college-scorecard-mcp-server",
  "license": "Apache-2.0",
  "keywords": ["mcp", "mcp-server", "model-context-protocol", "college-scorecard", "higher-education"],
  "userConfig": {
    "scorecard_api_key": {
      "type": "string",
      "title": "College Scorecard API key",
      "description": "Required. Free registration at api.data.gov/signup. 1,000 requests/hour.",
      "sensitive": true,
      "required": true
    }
  },
  "mcpServers": {
    "college-scorecard-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/college-scorecard-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio",
        "SCORECARD_API_KEY": "${user_config.scorecard_api_key}"
      }
    }
  }
}
